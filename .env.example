# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
#
# 1. Go to https://developer.uber.com and sign in with your own Uber account.
# 2. Create an application (any API suite works; "Others" is fine).
# 3. Under the app's Authentication settings, add this exact redirect URI:
#      http://127.0.0.1:5050/uber/callback
# 4. Copy the app's Client ID and Client Secret below.
#
# Without these two values set, RYDESAVYR just skips Uber login entirely and
# uses the formula-based Uber estimate instead — nothing else breaks.

UBER_CLIENT_ID=
UBER_CLIENT_SECRET=

# --- Google Maps ---
# One key powers three things: the Routes API (distance + travel time for
# every mode), the results-page Google Map, and that map's live per-mode
# routes. Enable "Routes API" AND "Maps JavaScript API" on the key's
# project at https://console.cloud.google.com/google/maps-apis and turn on
# billing (Google requires a billing account even within the free monthly
# credit). Without this, RYDESAVYR falls back to rate-card distance/time
# estimates and just hides the map — nothing else breaks.
GOOGLE_MAPS_API_KEY=

# --- MTA Bus Time ---
# Free MTA Bus Time API key for live bus arrivals — register at
# https://register.developer.obanyc.com/ (MTA says issued within ~30 min).
# Without this set, RYDESAVYR just skips live bus data and uses the
# formula-based Bus estimate instead — nothing else breaks.
MTA_BUS_API_KEY=

# Optional: overrides the dev Flask session secret.
# FLASK_SECRET_KEY=
