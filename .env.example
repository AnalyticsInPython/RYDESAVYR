# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
#
# Free MTA Bus Time API key for live bus arrivals — register at
# https://register.developer.obanyc.com/ (MTA says issued within ~30 min).
# Without this set, RYDESAVYR just skips live bus data and uses the
# formula-based Bus estimate instead — nothing else breaks.
MTA_BUS_API_KEY=

# Nothing else needs configuring: Citibike (citibike.py), Subway/Bus
# (mta_subway.py/mta_bus.py once the key above is set), and driving routes
# (routing.py, via OSRM's public demo server) are all free/keyless. Uber,
# Lyft, and Taxi use formula-based estimates (see modes.py) rather than a
# live-quote API — see the README for why.
