# Copy to .env and fill in your key. .env is gitignored.

# Google Cloud API key with the "Routes API" enabled and billing turned on.
# https://console.cloud.google.com/ -> APIs & Services -> Enable "Routes API"
# -> Credentials -> Create API key
GOOGLE_MAPS_API_KEY=

# Optional: overrides the dev Flask session secret.
# FLASK_SECRET_KEY=
